# ─── Next.js Backend API ───────────────────────
# URL for the Fastify backend API (v1 prefix)
NEXT_PUBLIC_API_URL=https://YOUR-API-HOST/api/v1

# ─── WooCommerce Store URL ────────────────────
# Upstream WooCommerce store URL (canonical www avoids 301 redirects)
WOOCOMMERCE_STORE_URL=https://www.nextdor.online/wp-json/wc/store/v1

# ─── Cloudinary Image Hosting ─────────────────
# CLOUDINARY_API_SECRET is server-only — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─── Support Contact ───────────────────────────
NEXT_PUBLIC_SUPPORT_PHONE=+233557507693
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=+233 55 750 7693
NEXT_PUBLIC_SUPPORT_WHATSAPP=+233557507693

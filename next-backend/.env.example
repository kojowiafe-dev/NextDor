# ─── NextDor API — environment template ──────────────────────────────────────
# Copy to `.env` (never commit the real file). Every value below is a PLACEHOLDER.
# The API validates this file at boot (src/config/env.ts) and refuses to start
# when a required value is missing or malformed.

# ─── Runtime ──────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── Database ─────────────────────────────
# DATABASE_URL: pooled connection used by Prisma Client at runtime.
# DIRECT_URL:   direct (non-pooled) connection used by `prisma migrate`.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Option A: Neon Cloud PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLED-HOST.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require

# Option B: Local Docker PostgreSQL (docker compose up -d in next-backend/)
# DATABASE_URL=postgresql://nextdor:nextdor_dev@localhost:5432/nextdor
# DIRECT_URL=postgresql://nextdor:nextdor_dev@localhost:5432/nextdor

# ─── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────
# At least 64 characters. Generate a UNIQUE value per environment:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production the API refuses to boot with any value that has ever been
# published in this repository.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_64_PLUS_CHARACTER_RANDOM_STRING_GENERATED_PER_ENVIRONMENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Paystack ─────────────────────────────
# Paystack signs webhooks with your SECRET KEY (there is no separate webhook
# secret). PAYSTACK_WEBHOOK_SECRET is deprecated and ignored.
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME_PAYSTACK_KEY
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME_PAYSTACK_KEY

# ─── Email Service ───────────────────────
# Production requires at least ONE provider (Resend or Cloudflare).
# Primary: Resend
# RESEND_API_KEY=re_CHANGE_ME
# Fallback: Cloudflare Email Sending (native REST API)
CLOUDFLARE_ACCOUNT_ID=your_32_character_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
EMAIL_FROM=NextDor <nextdor@nextdor.online>

# ─── Arkesel (Ghana SMS) ─────────────────
ARKESEL_API_KEY=CHANGE_ME
SMS_FROM=NextDor

# ─── WhatsApp Provider (Meta Cloud API or WATI) ─────
# Choose provider: 'wati' or 'meta' (default: meta, auto-switches to wati if WATI keys present)
WHATSAPP_PROVIDER=wati

# Option A: WATI (WhatsApp Team Inbox / BSP)
# Found in WATI Dashboard -> More -> API Docs
WATI_API_ENDPOINT=https://live-server-XXXXX.wati.io
WATI_ACCESS_TOKEN=your_wati_bearer_access_token

# Option B: Meta WhatsApp Cloud API
# Obtained from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_secret_verification_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# ─── CORS ─────────────────────────────────
# Comma-separated list of EXACT allowed browser origins.
# Add your deployed frontend URL here (e.g. https://your-app.vercel.app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nextdor.online
# Allow *.vercel.app / *.onrender.com / *.netlify.app / *.pages.dev preview
# origins. Defaults to true outside production and FALSE in production
# (credentialed CORS to arbitrary third-party subdomains is unsafe).
# CORS_ALLOW_PREVIEW_ORIGINS=false

# ─── API docs ─────────────────────────────
# Swagger UI at /docs is on in development and OFF in production unless set.
# ENABLE_API_DOCS=false

# ─── WooCommerce sync ─────────────────────
WOOCOMMERCE_STORE_URL=https://www.nextdor.online/wp-json/wc/store/v1

# ─── Cloudinary Image Hosting ─────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

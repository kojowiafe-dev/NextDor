# ─── Runtime ──────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── Database ─────────────────────────────
# DATABASE_URL is used by Prisma Client (and connection pooler)
# DIRECT_URL is required by prisma/schema.prisma (directUrl) for direct migrations / schema sync
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=...

# Option A: Neon Cloud PostgreSQL (from PROJECT_OVERVIEW.md)
DATABASE_URL=postgresql://neondb_owner:npg_xJ70zPqVdMoe@ep-tiny-water-a4q8h601.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:npg_xJ70zPqVdMoe@ep-tiny-water-a4q8h601.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Local Docker PostgreSQL
# DATABASE_URL=postgresql://nextdor:nextdor_dev@localhost:5432/nextdor
# DIRECT_URL=postgresql://nextdor:nextdor_dev@localhost:5432/nextdor

# ─── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────
# Must be at least 64 characters (enforced by Zod schema in src/config/env.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=4f7b2a9e8d1c6f3a5b0e7d9c2a4f6e8b1d3c5a7e9f0b2d4c6a8e1f3b5d7a9c2e0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Paystack ─────────────────────────────
# Secrets must be at least 10 characters (enforced by Zod schema)
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME_PAYSTACK_KEY
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME_PAYSTACK_KEY
PAYSTACK_WEBHOOK_SECRET=whsec_test_CHANGE_ME_WEBHOOK

# ─── Resend (Email) ───────────────────────
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=NextDor <nextdor@nextdor.online>

# ─── Arkesel (Ghana SMS) ─────────────────
ARKESEL_API_KEY=CHANGE_ME
SMS_FROM=NextDor

# ─── CORS ─────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nextdor.online,https://nextdor.onrender.com

# ─── WooCommerce sync ─────────────────────
WOOCOMMERCE_STORE_URL=https://www.nextdor.online/wp-json/wc/store/v1

# ─── Cloudinary Image Hosting ─────────────
CLOUDINARY_CLOUD_NAME=mq17etnb

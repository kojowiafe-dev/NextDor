# ─── Runtime ──────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── Database ─────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://nextdor:nextdor_dev@localhost:5432/nextdor

# ─── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_byte_hex_secret
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Paystack ─────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME

# ─── Resend (Email) ───────────────────────
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=NextDor <hello@nextdor.online>

# ─── Arkesel (Ghana SMS) ─────────────────
ARKESEL_API_KEY=CHANGE_ME
SMS_FROM=NextDor

# ─── CORS ─────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://nextdor.online

# ─── WooCommerce sync ─────────────────────
WOOCOMMERCE_STORE_URL=https://nextdor.online/wp-json/wc/store/v1

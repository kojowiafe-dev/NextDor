// NextDor — Prisma Schema
// Run `npx prisma migrate dev --name init` to create the first migration.
//
// DESIGN DECISIONS documented inline throughout.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// USERS & AUTH
// ═══════════════════════════════════════════════════════════════════

/// A registered user (customer or admin).
/// DESIGN: email is the primary identifier. We never use username —
/// email is memorable, universally unique, and doubles as recovery method.
model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique
  emailVerified Boolean    @default(false)
  passwordHash  String
  name          String
  phone         String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  /// Soft delete: set this to mark a user as deleted without losing order history.
  /// SHOULD INCASE: Hard deleting a user would cascade-delete their orders,
  /// which breaks financial audit requirements. Soft delete preserves the record.
  deletedAt     DateTime?

  vendorId      String?    @db.Uuid
  vendor        Vendor?    @relation("VendorStaff", fields: [vendorId], references: [id])
  ownedVendor   Vendor?    @relation("VendorOwner")

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([deletedAt]) // Efficient filter for "non-deleted users only"
  @@index([vendorId])
  @@map("users")
}

enum UserRole {
  CUSTOMER
  VENDOR_OWNER
  VENDOR_STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// ═══════════════════════════════════════════════════════════════════
// VENDORS & MARKETPLACE
// ═══════════════════════════════════════════════════════════════════

/// A vendor/merchant store on the NextDor marketplace.
model Vendor {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  slug                   String             @unique
  description            String?
  logoUrl                String?
  bannerUrl              String?
  phone                  String?
  email                  String?
  status                 VendorStatus       @default(PENDING_APPROVAL)
  /// Platform commission rate percentage (e.g. 10.00 = 10%)
  commissionRate         Decimal            @default(10.00) @db.Decimal(5, 2)
  payoutMethod           PayoutMethod       @default(MOMO)
  momoNumber             String?
  momoNetwork            String?            // "MTN", "TELECEL", "AT"
  bankName               String?
  bankAccountNumber      String?
  bankAccountName        String?
  paystackSubaccountCode String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  ownerId                String             @unique @db.Uuid
  owner                  User               @relation("VendorOwner", fields: [ownerId], references: [id])
  staff                  User[]             @relation("VendorStaff")
  products               Product[]
  vendorOrders           VendorOrder[]
  orderItems             OrderItem[]
  payouts                VendorPayout[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("vendors")
}

enum VendorStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum PayoutMethod {
  MOMO
  BANK
}

/// Opaque refresh tokens stored as bcrypt hashes.
/// DESIGN: We store a hash of the token, never the raw token itself.
/// Even if the database is compromised, raw tokens are not exposed.
/// The `family` field enables token-rotation theft detection:
/// if the same family's old token is replayed, all tokens in that family
/// are revoked and the user must re-authenticate.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  family    String    // UUID — shared across a rotation chain
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

/// Saved delivery addresses for a user.
model Address {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  label     String   @default("Home") // "Home", "Work", "Other"
  street    String
  city      String
  region    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
  @@map("addresses")
}

// ═══════════════════════════════════════════════════════════════════
// CATALOG
// ═══════════════════════════════════════════════════════════════════

/// Product category — supports a parent/child tree (one level deep for now).
model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// WooCommerce category ID — used by the sync worker for upserts.
  wcId        Int?       @unique
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?    @db.Uuid
  sortOrder   Int        @default(0)

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]  @relation("ProductCategories")

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

/// A product in the catalog.
/// DESIGN: Price is Decimal(12,2) — NEVER use Float for money.
/// Float has binary representation errors: 0.1 + 0.2 = 0.30000000000000004.
/// For GHS prices up to 9,999,999,999.99 (twelve digits, two decimal places).
///
/// WHAT IF: A product price changes between when a user adds it to their cart
/// and when they check out? We snapshot the price in OrderItem at checkout time.
/// The product price can change freely without affecting historical orders.
model Product {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wcId          Int?          @unique
  slug          String        @unique
  name          String
  description   String
  shortDesc     String?
  /// Current live price (what the customer pays today)
  price         Decimal       @db.Decimal(12, 2)
  /// Sale price — if set and non-null, this overrides `price` at checkout
  salePrice     Decimal?      @db.Decimal(12, 2)
  currency      String        @default("GHS")
  stockStatus   StockStatus   @default(IN_STOCK)
  stockQty      Int?          // null = unlimited (non-physical / unlimited stock)
  averageRating Decimal       @default(0) @db.Decimal(3, 2)
  reviewCount   Int           @default(0)
  sortOrder     Int           @default(0)
  /// Optimistic Concurrency Control (OCC) version counter
  version       Int           @default(1)
  vendorId      String?       @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  vendor        Vendor?       @relation(fields: [vendorId], references: [id])
  categories    Category[]    @relation("ProductCategories")
  images        ProductImage[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([slug])
  @@index([vendorId])
  @@index([deletedAt])
  @@index([stockStatus])
  @@map("products")
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
}

model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ═══════════════════════════════════════════════════════════════════
// ORDERS
// ═══════════════════════════════════════════════════════════════════

/// A placed order.
/// DESIGN: `shippingAddress` is a JSON snapshot of the address AT checkout time.
/// This is critical: if a user later edits their address, old orders must still
/// show where the original delivery was sent. Never store a FK to Address here —
/// FKs are live pointers, snapshots are immutable facts.
///
/// WHAT IF: We want to support guest checkout (no account)?
/// `userId` is nullable — guestEmail captures the guest's email for
/// order confirmation. A guest can "claim" their order by registering with
/// that same email after placing it.
model Order {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable order number shown to customers (ND-XXXXX)
  number          String               @unique
  userId          String?              @db.Uuid
  guestEmail      String?
  addressId       String?              @db.Uuid
  /// Immutable snapshot of the delivery address at time of checkout
  shippingAddress Json
  subtotal        Decimal              @db.Decimal(12, 2)
  deliveryFee     Decimal              @db.Decimal(12, 2)
  discount        Decimal              @default(0) @db.Decimal(12, 2)
  total           Decimal              @db.Decimal(12, 2)
  currency        String               @default("GHS")
  status          OrderStatus          @default(PENDING)
  paymentStatus   PaymentStatus        @default(UNPAID)
  deliveryMethod  DeliveryMethod       @default(STANDARD)
  couponId        String?              @db.Uuid
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User?                @relation(fields: [userId], references: [id])
  address         Address?             @relation(fields: [addressId], references: [id])
  items           OrderItem[]
  vendorOrders    VendorOrder[]
  payments        Payment[]
  statusHistory   OrderStatusHistory[]
  coupon          Coupon?              @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([number])
  @@index([status])
  @@index([createdAt])   // Admin "recent orders" queries
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
  PICKUP
}

/// Append-only log of every status change on an order.
/// DESIGN: We never UPDATE the status without writing to this table.
/// This gives us a complete audit trail: "Who changed this order to
/// REFUNDED and when?" — essential for dispute resolution and accounting.
model OrderStatusHistory {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  /// Admin user who made the change (null = automated/system change)
  createdBy String?     @db.Uuid
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

/// A single line item within an order.
/// DESIGN: productName, productImage, and unitPrice are SNAPSHOTS.
/// These columns are written at checkout and NEVER updated after that.
/// If the product is later renamed, deleted, or repriced — the order
/// still shows what the customer actually bought and paid.
model OrderItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String   @db.Uuid
  productId    String   @db.Uuid
  vendorId     String?  @db.Uuid
  /// Snapshot fields — immutable after insert
  productName  String
  productImage String?
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int
  subtotal     Decimal  @db.Decimal(12, 2)  // unitPrice * quantity at time of order

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
  @@map("order_items")
}

// ═══════════════════════════════════════════════════════════════════
// VENDOR SUB-ORDERS & SETTLEMENTS
// ═══════════════════════════════════════════════════════════════════

/// A vendor-specific sub-order partitioned from a Master Order.
/// DESIGN: The Master Order captures the customer transaction, while
/// VendorOrder models the independent fulfillment and financial settlement per merchant.
model VendorOrder {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String            @db.Uuid
  vendorId         String            @db.Uuid
  subtotal         Decimal           @db.Decimal(12, 2)
  commissionAmount Decimal           @db.Decimal(12, 2)
  vendorEarnings   Decimal           @db.Decimal(12, 2)
  status           VendorOrderStatus @default(PENDING)
  notes            String?
  /// When 48h escrow clearance passes and funds are unlocked for payout
  clearedAt        DateTime?
  payoutId         String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  payout           VendorPayout?     @relation(fields: [payoutId], references: [id])

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
  @@index([payoutId])
  @@map("vendor_orders")
}

enum VendorOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// A financial settlement disbursement to a vendor.
model VendorPayout {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId            String       @db.Uuid
  amount              Decimal      @db.Decimal(12, 2)
  currency            String       @default("GHS")
  status              PayoutStatus @default(PENDING)
  paystackTransferRef String?      @unique
  gatewayResponse     Json?
  paidAt              DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  vendor              Vendor       @relation(fields: [vendorId], references: [id])
  vendorOrders        VendorOrder[]

  @@index([vendorId])
  @@index([status])
  @@map("vendor_payouts")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// ═══════════════════════════════════════════════════════════════════
// PAYMENTS
// ═══════════════════════════════════════════════════════════════════

/// A payment transaction linked to an order.
/// One order can have multiple Payment rows — e.g. a failed attempt
/// followed by a successful retry are separate Payment records.
/// This makes debugging payment issues straightforward: every attempt
/// is recorded, including the full gateway response.
model Payment {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String          @db.Uuid
  /// Paystack transaction reference — globally unique
  paystackRef String          @unique
  method      PaymentMethod
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("GHS")
  status      PaymentTxStatus @default(PENDING)
  /// Raw gateway response stored as JSON for debugging
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())

  order       Order           @relation(fields: [orderId], references: [id])
  attempts    PaymentAttempt[]

  @@index([orderId])
  @@index([paystackRef])
  @@map("payments")
}

enum PaymentMethod {
  MOMO
  CARD
  BANK_TRANSFER
}

enum PaymentTxStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

/// Individual webhook calls from Paystack for a Payment.
/// Paystack may send multiple webhooks for the same transaction
/// (retries, status updates). We log every one for idempotency auditing.
model PaymentAttempt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String   @db.Uuid
  status      String
  /// Full Paystack webhook payload
  gatewayResp Json
  createdAt   DateTime @default(now())

  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_attempts")
}

// ═══════════════════════════════════════════════════════════════════
// REVIEWS
// ═══════════════════════════════════════════════════════════════════

/// A product review.
/// DESIGN: `verified` = true means the reviewer has a completed order
/// containing this product. Verified reviews rank higher in the UI.
/// `approved` = false by default — an admin must approve before it's public.
/// This prevents spam and fake reviews without requiring moderation
/// of every single review (only new/flagged ones show in the admin queue).
model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  userId    String?  @db.Uuid
  guestName String?
  /// 1–5 stars. A CHECK constraint is added in the migration:
  /// ALTER TABLE reviews ADD CONSTRAINT rating_range CHECK (rating BETWEEN 1 AND 5);
  rating    Int
  title     String
  body      String
  verified  Boolean  @default(false)
  approved  Boolean  @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([productId, approved]) // Efficient "get approved reviews for product X"
  @@index([userId])
  @@map("reviews")
}

// ═══════════════════════════════════════════════════════════════════
// COUPONS
// ═══════════════════════════════════════════════════════════════════

/// Discount coupon codes.
/// WHAT IF: Two users try to use the last remaining use of a coupon
/// simultaneously? We need an atomic check-and-increment.
/// Solution: use a database transaction with SELECT FOR UPDATE on the
/// coupon row, increment usedCount, then create the order — all in one
/// atomic transaction. This prevents race conditions (overselling coupons).
model Coupon {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String       @unique
  type        DiscountType
  /// For FIXED: amount in GHS. For PERCENTAGE: 0.0–100.0
  value       Decimal      @db.Decimal(10, 2)
  minOrderAmt Decimal?     @db.Decimal(12, 2)
  maxUses     Int?         // null = unlimited
  usedCount   Int          @default(0)
  expiresAt   DateTime?    // null = never expires
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  orders      Order[]

  @@index([code])
  @@map("coupons")
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

// ═══════════════════════════════════════════════════════════════════
// AUDIT LOGS
// ═══════════════════════════════════════════════════════════════════

/// Immutable platform audit trail for administrative governance and compliance.
/// DESIGN: Records "who updated what", tracking actor identity, IP, action type,
/// entity target, and timestamp.
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @db.Uuid
  userEmail String?
  action    String   // e.g. "MERCHANT_APPROVED", "MERCHANT_SUSPENDED", "ADMIN_CREATED", "ADMIN_DEACTIVATED", "COMMISSION_UPDATED"
  entity    String   // e.g. "Vendor", "User", "Product", "Settings"
  entityId  String?
  details   Json?    // Contextual payload or state diff
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

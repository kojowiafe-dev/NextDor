# ─── NextDor Monorepo Root Environment (TEMPLATE — placeholders only) ────────
# Per-app templates with full documentation live in:
#   next-backend/.env.example
#   next-frontend/.env.example
# Never commit real credentials.

# Backend settings
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLED-HOST.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate a unique 64+ char value per environment)
JWT_SECRET=REPLACE_WITH_A_UNIQUE_64_PLUS_CHARACTER_RANDOM_STRING_GENERATED_PER_ENVIRONMENT

# Paystack (webhooks are signed with the secret key)
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME_PAYSTACK_KEY
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME_PAYSTACK_KEY

# Services
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=NextDor <hello@nextdor.online>
ARKESEL_API_KEY=CHANGE_ME
SMS_FROM=NextDor

# Frontend settings
NEXT_PUBLIC_API_URL=https://YOUR-API-HOST/api/v1
WOOCOMMERCE_STORE_URL=https://www.nextdor.online/wp-json/wc/store/v1
